# 复制为.env后填写；不把真实凭据提交到Git。
LR_ENVIRONMENT=development
LR_ADAPTER_MODE=demo
LR_DATABASE_URL=sqlite:///runtime/loss-repricing.db
LR_ADMIN_USERNAME=admin
LR_ADMIN_PASSWORD=
LR_SESSION_SECRET=
LR_SECURE_COOKIE=false
LR_LIVE_SUBMIT_ENABLED=false
# 技术日志独立于业务证据；按角色/进程写入runtime/logs，不记录请求正文或凭据。
LR_LOG_LEVEL=INFO
LR_LOG_MAX_BYTES=20971520
LR_LOG_RETENTION_DAYS=14
LR_LOG_TOTAL_BYTES=1073741824
# 真实数据源准备好后配置以下项；当前留空。
# 销售系统自动登录：账号密码仅存本项目.env；Token进程内缓存，到期前重新登录。
LR_VENDOR_API_URL=http://121.46.237.218:8071
LR_VENDOR_USERNAME=
LR_VENDOR_PASSWORD=
LR_ERP_TOKEN=
# 未填写ERP_TOKEN时，使用独立账号密码登录公司开放接口。
LR_ERP_OPEN_API_URL=http://103.198.125.2:16777/open
LR_ERP_USERNAME=
LR_ERP_PASSWORD=
# 网页端已核实的四组候选抽样范围；平台名称与平台ID必须对应。
LR_ERP_CAPTURE_PLATFORM=Tiktok
LR_ERP_CAPTURE_PLATFORM_ID=9B583641B0CA11EDAAB1AC1F6B9B9987
LR_ERP_CAPTURE_BLOC=集团二部

# 销售协作与钉钉通知，默认仅模拟。
LR_COORDINATION_REQUIRED=true
# 真实写入独占尚待核实，不因启用协作或完成读前检查而改为true。
LR_LIVE_WRITER_EXCLUSIVE=false

# 钉钉通知默认演示；demo只写本地模拟记录，不代表真实送达。
LR_NOTIFICATION_MODE=demo
LR_DING_ENABLED=false
# 企业内部应用专用配置；不复制预算程序或其他项目的凭据。
LR_DING_CORP_ID=
LR_DING_CLIENT_ID=
LR_DING_CLIENT_SECRET=
LR_DING_AGENT_ID=
# 真实通知需员工可访问的HTTPS网页地址；不得附带访问令牌或查询参数。
LR_PUBLIC_BASE_URL=

# 只读真实提价执行与人工保护档案。demo/file环境必须显式指向权威live数据库；
# 空值不会用当前demo库宣称“无历史/无保护”，也不会打开真实提交。
LR_LIVE_HISTORY_DATABASE_URL=
