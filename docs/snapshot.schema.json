{
  "$defs": {
    "CandidateSourceIssue": {
      "description": "可定位的候选明细字段异常。保留行身份用于去重和整单亏损归属检查。",
      "properties": {
        "source": {
          "enum": [
            "loss_allocatable",
            "loss_pending",
            "blocked_allocatable",
            "blocked_pending"
          ],
          "title": "Source",
          "type": "string"
        },
        "record_number": {
          "exclusiveMinimum": 0,
          "title": "Record Number",
          "type": "integer"
        },
        "key": {
          "$ref": "#/$defs/VariantReference"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "row_id": {
          "title": "Row Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "record_number",
        "key",
        "order_id",
        "row_id"
      ],
      "title": "CandidateSourceIssue",
      "type": "object"
    },
    "FeeModel": {
      "description": "一次毛利系数无量纲，固定成本按明确比值换成站点币，输出仍为站点币。",
      "properties": {
        "revenue_factor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Revenue Factor"
        },
        "fixed_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Fixed Cost"
        },
        "fixed_cost_divisor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "1",
          "title": "Fixed Cost Divisor"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "revenue_factor",
        "fixed_cost",
        "version"
      ],
      "title": "FeeModel",
      "type": "object"
    },
    "OnlineProfitCheck": {
      "description": "11/12新增的完整在线利润校验，与排除广告营销的一次毛利分开。\n\n库存为当前目标的海外可售件数；0明确选直发，正数选海外仓。模型以站点币\n实际售价输入，保留部门底表及库存来源，不使用切价售价对应的利润率。",
      "properties": {
        "overseas_stock": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Overseas Stock"
        },
        "mode": {
          "enum": [
            "direct",
            "overseas"
          ],
          "title": "Mode",
          "type": "string"
        },
        "department": {
          "title": "Department",
          "type": "string"
        },
        "inventory_observed_at": {
          "format": "date-time",
          "title": "Inventory Observed At",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/FeeModel"
        }
      },
      "required": [
        "overseas_stock",
        "mode",
        "department",
        "inventory_observed_at",
        "source_ref",
        "model"
      ],
      "title": "OnlineProfitCheck",
      "type": "object"
    },
    "OnlineSourceIssue": {
      "description": "可定位的在线记录字段异常。主 SKU 是七天销量保护的共享范围。",
      "properties": {
        "source": {
          "const": "online",
          "title": "Source",
          "type": "string"
        },
        "record_number": {
          "exclusiveMinimum": 0,
          "title": "Record Number",
          "type": "integer"
        },
        "key": {
          "$ref": "#/$defs/VariantReference"
        },
        "main_sku": {
          "title": "Main Sku",
          "type": "string"
        },
        "related_main_skus": {
          "items": {
            "type": "string"
          },
          "title": "Related Main Skus",
          "type": "array"
        }
      },
      "required": [
        "source",
        "record_number",
        "key",
        "main_sku"
      ],
      "title": "OnlineSourceIssue",
      "type": "object"
    },
    "OnlineState": {
      "description": "在线子 SKU 的当前快照。含 VAT 零售价和营销实际售价均为站点币。",
      "properties": {
        "key": {
          "$ref": "#/$defs/VariantKey"
        },
        "main_sku": {
          "title": "Main Sku",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "retail_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Retail Price"
        },
        "marketing_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marketing Price"
        },
        "current_margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Current Margin"
        },
        "fee_scope": {
          "title": "Fee Scope",
          "type": "string"
        },
        "profit_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnlineProfitCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "sales_7d": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sales 7D"
        },
        "sales_basis": {
          "anyOf": [
            {
              "const": "erp_goods_warehouse_seven_days_reference",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sales Basis"
        },
        "sales_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sales Observed At"
        },
        "sales_complete": {
          "default": false,
          "title": "Sales Complete",
          "type": "boolean"
        },
        "history_known": {
          "default": false,
          "title": "History Known",
          "type": "boolean"
        },
        "recent_price_log": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecentPriceLog"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_increase_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Increase At"
        },
        "pending_submission": {
          "default": false,
          "title": "Pending Submission",
          "type": "boolean"
        },
        "protected": {
          "default": false,
          "title": "Protected",
          "type": "boolean"
        },
        "activity_locked": {
          "default": false,
          "title": "Activity Locked",
          "type": "boolean"
        },
        "sellable": {
          "default": true,
          "title": "Sellable",
          "type": "boolean"
        },
        "price_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Version"
        },
        "last_changed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Changed At"
        }
      },
      "required": [
        "key",
        "main_sku",
        "currency",
        "retail_price",
        "current_margin",
        "fee_scope",
        "observed_at"
      ],
      "title": "OnlineState",
      "type": "object"
    },
    "RecentPriceLog": {
      "description": "开放接口按子商品ID返回的72小时日志数量；不伪造最近生效时间。",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "count",
        "window_start",
        "window_end",
        "source_id"
      ],
      "title": "RecentPriceLog",
      "type": "object"
    },
    "SiteContract": {
      "description": "站点合同定义上传字段、价格档位与舍入规则，由数据提供方明确确认。",
      "properties": {
        "site": {
          "enum": [
            "MY",
            "PH",
            "SG",
            "TH",
            "VN"
          ],
          "title": "Site",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "price_step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Price Step"
        },
        "rounding": {
          "enum": [
            "ROUND_HALF_UP",
            "ROUND_DOWN",
            "ROUND_UP"
          ],
          "title": "Rounding",
          "type": "string"
        },
        "upload_column": {
          "title": "Upload Column",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "warehouses": {
          "items": {
            "type": "string"
          },
          "title": "Warehouses",
          "type": "array"
        }
      },
      "required": [
        "site",
        "price_step",
        "rounding",
        "upload_column",
        "version"
      ],
      "title": "SiteContract",
      "type": "object"
    },
    "SourceLine": {
      "description": "四份 ERP 候选导出之一。亏损额的符号、数量粒度和原始币种在归一化前保留。",
      "properties": {
        "row_id": {
          "default": "",
          "title": "Row Id",
          "type": "string"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "loss_allocatable",
            "loss_pending",
            "blocked_allocatable",
            "blocked_pending"
          ],
          "title": "Source",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/VariantKey"
        },
        "main_sku": {
          "title": "Main Sku",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "loss_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Loss Amount"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "basis": {
          "enum": [
            "unit",
            "line",
            "order"
          ],
          "title": "Basis",
          "type": "string"
        },
        "allocation_reliable": {
          "default": false,
          "title": "Allocation Reliable",
          "type": "boolean"
        },
        "fee_scope": {
          "default": "normal",
          "title": "Fee Scope",
          "type": "string"
        },
        "abnormal": {
          "default": false,
          "title": "Abnormal",
          "type": "boolean"
        },
        "source_ref": {
          "default": "",
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "source",
        "key",
        "main_sku",
        "quantity",
        "loss_amount",
        "currency",
        "basis"
      ],
      "title": "SourceLine",
      "type": "object"
    },
    "VariantKey": {
      "description": "商品 ID 与 SKU 按原始文本保留，避免数值化丢失前导零。",
      "properties": {
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "shop_id": {
          "title": "Shop Id",
          "type": "string"
        },
        "site": {
          "enum": [
            "MY",
            "PH",
            "SG",
            "TH",
            "VN"
          ],
          "title": "Site",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "warehouse": {
          "title": "Warehouse",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "shop_id",
        "site",
        "product_id",
        "item_id",
        "sku",
        "warehouse"
      ],
      "title": "VariantKey",
      "type": "object"
    },
    "VariantReference": {
      "description": "已定位的来源变体。字段异常记录可以保留仓配缺失的原状。",
      "properties": {
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "shop_id": {
          "title": "Shop Id",
          "type": "string"
        },
        "site": {
          "enum": [
            "MY",
            "PH",
            "SG",
            "TH",
            "VN"
          ],
          "title": "Site",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "warehouse": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Warehouse"
        }
      },
      "required": [
        "platform",
        "shop_id",
        "site",
        "product_id",
        "item_id",
        "sku",
        "warehouse"
      ],
      "title": "VariantReference",
      "type": "object"
    }
  },
  "description": "单批规范来源；日期按北京时间，汇率必须携带明确单位后参与精确比值计算。",
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "business_date": {
      "format": "date",
      "title": "Business Date",
      "type": "string"
    },
    "fx_date": {
      "format": "date",
      "title": "Fx Date",
      "type": "string"
    },
    "fx_rates": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Fx Rates",
      "type": "object"
    },
    "fx_rate_unit": {
      "default": "currency_per_cny",
      "enum": [
        "currency_per_cny",
        "cny_per_currency"
      ],
      "title": "Fx Rate Unit",
      "type": "string"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/SourceLine"
      },
      "title": "Lines",
      "type": "array"
    },
    "online": {
      "items": {
        "$ref": "#/$defs/OnlineState"
      },
      "title": "Online",
      "type": "array"
    },
    "contracts": {
      "additionalProperties": {
        "$ref": "#/$defs/SiteContract"
      },
      "title": "Contracts",
      "type": "object"
    },
    "complete_sources": {
      "items": {
        "type": "string"
      },
      "title": "Complete Sources",
      "type": "array"
    },
    "source_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Versions",
      "type": "object"
    },
    "source_issues": {
      "items": {
        "discriminator": {
          "mapping": {
            "blocked_allocatable": "#/$defs/CandidateSourceIssue",
            "blocked_pending": "#/$defs/CandidateSourceIssue",
            "loss_allocatable": "#/$defs/CandidateSourceIssue",
            "loss_pending": "#/$defs/CandidateSourceIssue",
            "online": "#/$defs/OnlineSourceIssue"
          },
          "propertyName": "source"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CandidateSourceIssue"
          },
          {
            "$ref": "#/$defs/OnlineSourceIssue"
          }
        ]
      },
      "title": "Source Issues",
      "type": "array"
    }
  },
  "required": [
    "as_of",
    "business_date",
    "fx_date",
    "fx_rates",
    "lines",
    "online",
    "contracts",
    "complete_sources"
  ],
  "title": "Snapshot",
  "type": "object"
}
